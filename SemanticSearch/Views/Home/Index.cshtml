@model SemanticSearch.Models.SearchViewModel

@{
    ViewData["Title"] = "Семантичний Пошук";
}

<div class="container flex-grow-1 d-flex flex-column py-4" style="background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); border-radius: 16px; margin-bottom: 24px;">

    <!-- Рядок макета: g-0 прибирає зазори, дозволяючи лівій і правій колонкам ідеально з'єднатися -->
    <div class="row g-0 flex-grow-1">

        <!-- ЛІВА КОЛОНКА: Робоча зона чату (Заокруглення тільки зліва) -->
        <div class="col-lg-8 col-12 p-4 d-flex flex-column" style="background: white; border-top-left-radius: 16px; border-bottom-left-radius: 16px;">

            <!-- Заголовок чату -->
            <div class="mb-4">
                <h1 class="fw-bold text-dark mb-1"><i class="bi bi-chat-dots-fill text-info"></i> Інтелектуальний Пошук</h1>
                <p class="text-muted mb-0">Задайте питання природною мовою, і ІІ знайде відповідь</p>
            </div>

            <!-- Вікно діалогу (flex-grow-1 змушує його займати весь вільний простір по висоті) -->
            <div class="card shadow border-0 flex-grow-1 mb-4" id="chatWindow" style="overflow-y: auto; background: #f8f9fa;">
                <div class="card-body d-flex flex-column">

                    @if (!Model.IsSearched)
                    {
                        <!-- Стан: Порожній чат -->
                        <div class="text-center text-muted py-5 my-auto">
                            <i class="bi bi-chat-left-dots fs-1 text-secondary mb-3 d-block"></i>
                            <h5>Діалог порожній</h5>
                            <p class="small">Введіть ваше запитання нижче, щоб почати</p>
                        </div>
                    }
                    else
                    {
                        <!-- Стан: Активний діалог -->
                        <div class="d-flex flex-column gap-4">
                            <!-- Повідомлення користувача -->
                            <div class="d-flex align-items-end justify-content-end gap-3">
                                <div class="bg-primary text-white p-3 rounded-4 shadow-sm" style="max-width: 75%;">
                                    <p class="mb-0">@Model.Query</p>
                                </div>
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            </div>

                            <!-- Відповідь ШІ -->
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 45px; height: 45px;">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="bg-white text-dark p-4 rounded-4 shadow-sm border" style="border-left: 5px solid #0dcaf0; max-width: 75%;">
                                    <h6 class="fw-bold text-info mb-3"><i class="bi bi-stars me-2"></i>Відповідь ІІ:</h6>
                                    <p class="mb-0" style="white-space: pre-line; line-height: 1.6; word-break: break-word;" id="aiResponseText">
                                        @(string.IsNullOrEmpty(Model.AiResponse) ? "На жаль, ІІ не змогла сгенерувати відповідь." : Model.AiResponse)
                                    </p>
                                </div>
                            </div>

                            <!-- Викликані функції (якщо є) -->
                            @if (Model.ExecutedFunctions?.Count > 0)
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>Виконані функції:</h6>
                                    @foreach (var func in Model.ExecutedFunctions)
                                    {
                                        <div class="alert alert-success border-0 d-flex gap-2 align-items-start mb-2">
                                            <i class="bi bi-lightning-fill mt-1" style="color: #198754;"></i>
                                            <div>
                                                <strong>@func.Name</strong>
                                                @if (func.Params?.Count > 0)
                                                {
                                                    <div class="small text-muted mt-1">
                                                        <code>@string.Join(", ", func.Params.Select(p => $"{p.Key}: {p.Value}"))</code>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>

            <!-- Форма введення запиту -->
            <form asp-action="Index" method="post" id="searchForm">
                <div class="input-group input-group-lg shadow rounded-4 overflow-hidden">
                    <input type="text" name="Query" class="form-control border-0 ps-4" placeholder="Задайте питання..." value="@Model.Query" required autocomplete="off" />
                    <button class="btn btn-info px-5 d-flex align-items-center gap-2 fw-semibold" type="submit" id="submitBtn">
                        <span>Відправити</span>
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </form>

            <!-- Індикатор завантаження -->
            <div id="loader" class="text-center mt-3 d-none">
                <div class="spinner-border spinner-border-sm text-info me-2" role="status"></div>
                <span class="text-muted small">ІІ думає і шукає по вектору...</span>
            </div>

        </div>

        <!-- ПРАВА КОЛОНКА: Панель інформації (Заокруглення тільки справа + синя напівпрозора окантовка) -->
        <div class="col-lg-4 col-12 p-4 d-flex flex-column" style="background: rgba(255, 255, 255, 0.95); border-left: 1px solid rgba(102, 126, 234, 0.25); border-top-right-radius: 16px; border-bottom-right-radius: 16px;">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle-fill text-info me-2"></i>Інформація</h5>

            <!-- Картка: Приклади -->
            <div class="card border-0 bg-light mb-3">
                <div class="card-body">
                    <h6 class="card-title fw-semibold text-dark"><i class="bi bi-lightbulb text-warning me-2"></i>Приклади:</h6>
                    <ul class="small list-unstyled mb-0">
                        <li><i class="bi bi-arrow-right text-info me-2"></i>Яка погода в Харкові?</li>
                        <li><i class="bi bi-arrow-right text-info me-2"></i>Який курс долара?</li>
                        <li><i class="bi bi-arrow-right text-info me-2"></i>Знайди що таке Семантичний пошук?</li>
                        <li><i class="bi bi-arrow-right text-info me-2"></i>Ціна золота сьогодні</li>
                    </ul>
                </div>
            </div>

            <!-- Картка: Як це працює -->
            <div class="card border-0 bg-info bg-opacity-10 mb-3">
                <div class="card-body">
                    <h6 class="card-title fw-semibold text-info"><i class="bi bi-gear-fill me-2"></i>Як це працює:</h6>
                    <p class="small text-muted mb-0">Система розуміє запитання, знаходить функції та виконує їх для результату.</p>
                </div>
            </div>

            <!-- Картка: Безпека -->
            <div class="card border-0 bg-success bg-opacity-10">
                <div class="card-body">
                    <h6 class="card-title fw-semibold text-success"><i class="bi bi-shield-check me-2"></i>Безпека:</h6>
                    <p class="small text-muted mb-0">Запитання обробляються конфіденційно без збереження без згоди.</p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function scrollChatToBottom() {
            const chatWindow = document.getElementById('chatWindow');
            if (chatWindow) chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function clearChat() {
            const chatWindow = document.getElementById('chatWindow');
            chatWindow.innerHTML = `<div class="card-body d-flex flex-column">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-chat-left-dots fs-1 text-secondary mb-3 d-block"></i>
                    <h5>Діалог порожній</h5>
                    <p class="small">Введіть ваше запитання нижче, щоб почати</p>
                </div>
            </div>`;
        }

        function formatLinksInResponse() {
            const responseText = document.getElementById('aiResponseText');
            if (!responseText) return;

            let text = responseText.innerText;

            const urlRegex = /(https?:\/\/[^\s]+|www\.[^\s]+)/g;

            let html = text.replace(urlRegex, function(match) {
                let url = match;
                let trailingPunctuation = '';

                const matchTrailing = url.match(/([.),;!]+)$/);
                if (matchTrailing) {
                    trailingPunctuation = matchTrailing[1];
                    url = url.slice(0, -trailingPunctuation.length);
                }

                const hrefValue = url.startsWith('www.') ? `https://${url}` : url;

                let displayUrl = url;
                try {
                    displayUrl = decodeURIComponent(url);
                } catch (e) {
                    console.error("Ошибка декодирования URL:", e);
                }

                return `<a href="${hrefValue}" target="_blank" rel="noopener noreferrer" class="text-info text-decoration-none fw-semibold" style="border-bottom: 1px dashed #0dcaf0; word-break: break-all;">${displayUrl}</a>${trailingPunctuation}`;
            });

            html = html.replace(/\n/g, '<br>');

            responseText.innerHTML = html;
        }

        document.addEventListener('DOMContentLoaded', function() {
            scrollChatToBottom();
            formatLinksInResponse();
        });

        window.addEventListener('load', function() {
            scrollChatToBottom();
            formatLinksInResponse();
        });

        document.getElementById('searchForm').addEventListener('submit', function() {
            clearChat();
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span>Очікування...</span>';
            document.getElementById('loader').classList.remove('d-none');
            setTimeout(scrollChatToBottom, 100);
        });
    </script>
}
